# ─────────────────────────────────────────────────────────────────────────────
#  Cerquín — plantilla de producción
#
#  Copiá este archivo a .env en el servidor y llenalo. Todo lo que dice
#  CAMBIAR es obligatorio: «php artisan contable:check-produccion» se niega a
#  dar el visto bueno mientras falte.
#
#  El .env NUNCA va al repositorio. En el servidor debe quedar 640 y del
#  usuario de la aplicación:  chmod 640 .env && chown contable:nginx .env
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Cerquín"
APP_ENV=production

# Se genera en el servidor con «php artisan key:generate».
# Si se cambia después, todo lo cifrado y todas las sesiones dejan de servir.
APP_KEY=

# En false. En true, un error 500 le muestra al visitante el código, la consulta
# SQL y las variables de entorno —con la contraseña de la base adentro—.
APP_DEBUG=false

# Con https y sin barra final. De aquí salen los enlaces de los correos y de
# los PDF: si dice http, esos enlaces salen en http aunque el sitio tenga TLS.
APP_URL=https://CAMBIAR.hn

APP_TIMEZONE=America/Tegucigalpa
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Registro ────────────────────────────────────────────────────────────────
# «daily» rota solo; «single» crece hasta llenar el disco.
# En «debug» acaban datos de los clientes dentro del archivo de log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos ───────────────────────────────────────────────────────────
# Usuario propio, jamás root: si la aplicación entra como root, un error puede
# alcanzar cualquier base del servidor y no solo la suya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=contable
DB_USERNAME=contable
DB_PASSWORD=CAMBIAR
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# ── Sesión ──────────────────────────────────────────────────────────────────
# La cookie solo viaja por HTTPS y JavaScript no la puede leer.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=CAMBIAR.hn
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Respaldos ───────────────────────────────────────────────────────────────
# Fuera del proyecto: un respaldo en el mismo disco se pierde con el disco.
# De esa carpeta, algo tiene que llevárselos fuera del servidor.
BACKUP_PATH=/var/backups/contable
BACKUP_KEEP_DAYS=30
# En Linux mysqldump está en el PATH; esta línea solo hace falta en Windows.
# MYSQLDUMP_PATH=mysqldump

# ── Correo ──────────────────────────────────────────────────────────────────
# Sin esto nadie puede recuperar su contraseña olvidada.
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-responder@CAMBIAR.hn"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
